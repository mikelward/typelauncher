<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Requested only from the Settings "Search contacts" toggle; backs the
         typed-search contacts section. Never requested at first run. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Requested the first time the user favorites a contact or sets one of
         their numbers as the default from the long-press menu; a denial simply
         drops that one action. Never requested at first run. -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- Requested only with Settings "Use default dialer" turned off (on by
         default), the first time the user taps Call on a contact's quick-action
         card; a denial — and the default setting — falls back to opening the
         default dialer with the number pre-filled. Never requested at first
         run. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- CALL_PHONE implies telephony hardware; declare it optional so the
         launcher still installs on tablets / ChromeOS with no phone radio (the
         Call action simply won't resolve there). -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="${launcherIcon}"
        android:label="@string/app_name"
        android:roundIcon="${launcherRoundIcon}"
        android:supportsRtl="true"
        android:theme="@style/Theme.TypeLauncher">

        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Applies the platform's old→new widget ID translation after a backup
            restore. Delivered even when the launcher isn't running, so it must
            be a manifest receiver. exported="true" is required for the system
            (a different UID) to deliver it; safe because
            APPWIDGET_HOST_RESTORED is a framework protected-broadcast that only
            the system can send.
        -->
        <receiver
            android:name=".WidgetRestoredReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_HOST_RESTORED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
