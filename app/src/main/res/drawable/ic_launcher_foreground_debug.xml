        <!-- Same geometry as the DEV badge (ic_launcher_foreground_local): the T mark
             is scaled down and lifted into the upper safe zone so the badge below it
             stays inside the central 72dp the adaptive-icon mask is guaranteed to
             show. -->
    <group
            android:pivotX="54"
            android:pivotY="54"
            android:scaleX="0.7"
            android:scaleY="0.7"
            android:translateY="-12">
            <!-- Hollow rectangle above the T, stylised as a search/filter bar -->
            <path
                android:fillColor="#00000000"
                android:strokeColor="#FF000000"
                android:strokeWidth="1.5"
                android:pathData="M34,27 H74 V35 H34 Z" />
            <!-- Caret inside the rectangle -->
            <path
                android:fillColor="#FF000000"
                android:pathData="M39,29.5 H40 V32.5 H39 Z" />
            <!-- Letter T -->
            <path
                android:fillColor="#FF000000"
                android:pathData="M34,40 H74 V50 H59 V84 H49 V50 H34 Z" />
        </group>
    <!-- Tester-build badge: a yellow bar reading "DEBUG". The two badges are one
         scheme — same bar, same baseline, same typeface (DejaVu Sans Mono) and the
         same cap height — differing only in the word. That cap is 6.0 rather than
         the 7 the DEV bar once used because five letters at 7 span 41.5 viewport
         units and only 37.2 fit inside the 66dp circle every adaptive-icon mask
         covers; a badge the mask clips is worse than none, since the icon then
         just looks like the real one, so both words use the size that fits. -->
