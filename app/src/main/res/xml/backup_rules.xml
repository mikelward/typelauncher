<?xml version="1.0" encoding="utf-8"?><!--
   Legacy full-backup scope (API <= 30). minSdk is 34, so no device actually
   uses this file; the operative rules live in data_extraction_rules.xml. Kept
   in sync for correctness: app-widget IDs are device-local and must never be
   restored onto another device (see data_extraction_rules.xml), so the
   `widgets` SharedPreferences is excluded here too.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="widgets.xml" />
</full-backup-content>
