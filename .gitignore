# Ignore all dotfiles and dot-directories by default; allowlist below.
.*
!/.github
!/.github/**
!/.gitignore
!.gitkeep
# Claude Code shared config (SessionStart hook + settings) must be tracked so
# remote web sessions pick it up; keep machine-local overrides ignored.
!/.claude
!/.claude/**
/.claude/settings.local.json

*.iml
__pycache__/
/local.properties
/build
/captures
local.properties
app/build
*.keystore
*.jks
# Firebase per-project config; not strictly secret, but the Firebase project is
# private to the maintainer. Forks and the sandbox build cleanly without it —
# see docs/firebase-telemetry.md.
app/google-services.json
